{% extends 'site/components/_base.html.twig' %}

{% block title %}Erreur {{ status_code }}{% endblock %}

{% block body %}
    <section class="jd-hero">
        <div class="jd-hero__glow jd-hero__glow--teal"></div>
        <div class="jd-hero__clip">
            <div class="jd-hero__glow jd-hero__glow--navy"></div>
        </div>

        <div class="container position-relative jd-hero__inner d-flex justify-content-center">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6">
                <span class="jd-hero__eyebrow d-flex justify-content-center">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>Erreur {{ status_code }}
                </span>
                <h1 class="jd-hero__title text-center mb-4">{{ status_text }}</h1>

                <div class="jd-terminal">
                    <div class="jd-terminal__bar">
                        <span class="jd-terminal-dot jd-terminal-dot--red"></span>
                        <span class="jd-terminal-dot jd-terminal-dot--yellow"></span>
                        <span class="jd-terminal-dot jd-terminal-dot--green"></span>
                        <span class="jd-terminal__title">rene@je-developpe — zsh</span>
                    </div>
                    <div class="jd-terminal__body">
                        <p class="jd-terminal-line">
                            <span class="jd-terminal-prompt">$</span> cd {{ app.request is defined and app.request is not null ? app.request.pathinfo : '?' }}
                        </p>
                        <p class="jd-terminal-line jd-terminal-line--indent" style="color: #ff8a80;">
                            zsh: {{ status_text|lower }} (erreur {{ status_code }})
                        </p>
                        <p class="jd-terminal-line"><span class="jd-terminal-prompt">$</span> <span class="jd-terminal-cursor"></span></p>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
                    <a href="#" onclick="history.back(); return false;" class="btn btn-outline-light rounded-pill px-4">
                        <i class="fa-solid fa-arrow-left me-2"></i>Page précédente
                    </a>
                    <a href="{{ path('site_home') }}" class="btn btn-light rounded-pill px-4 fw-semibold">
                        <i class="fa-solid fa-house me-2"></i>Retour à l'accueil
                    </a>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
