{% extends "site/components/_base.html.twig" %}

{% block title %}{{ h1 }}{% endblock %}

{% block body %}

    <section class="jd-hero">
        <div class="jd-hero__glow jd-hero__glow--teal"></div>
        <div class="jd-hero__clip">
            <div class="jd-hero__glow jd-hero__glow--navy"></div>
        </div>

        <div class="container position-relative jd-hero__inner">
            <div class="row align-items-center g-5">
                <div class="col-12 col-lg-6">
                    <span class="jd-hero__eyebrow">
                        <i class="fa-solid fa-code me-2"></i>Portfolio &amp; compétences
                    </span>
                    <h1 class="jd-hero__title">{{ h1 }}</h1>
                    <p class="jd-hero__lead">
                        J'ai créé ce petit site pour partager ce que j'apprends et ce que je construis, en toute transparence.
                    </p>

                    <div class="jd-hero__stats">
                        {% if yearsOfExperience is not null %}
                            <div class="jd-stat">
                                <span class="jd-stat__value">{{ yearsOfExperience }}</span>
                                <span class="jd-stat__label">Ans de pratique</span>
                            </div>
                        {% endif %}
                        <div class="jd-stat">
                            <span class="jd-stat__value">{{ projectsCount }}</span>
                            <span class="jd-stat__label">Projets réalisés</span>
                        </div>
                        <div class="jd-stat">
                            <span class="jd-stat__value">{{ technologiesCount }}</span>
                            <span class="jd-stat__label">Technologies</span>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a href="{{ path('site_my_projects') }}" class="btn btn-light rounded-pill px-4 fw-semibold">
                            Voir mes réalisations
                        </a>
                        <a href="{{ path('site_contact') }}" class="btn btn-outline-light rounded-pill px-4">
                            <i class="fa-solid fa-envelope-open-text me-2"></i>Me contacter
                        </a>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="jd-terminal">
                        <div class="jd-terminal__bar">
                            <span class="jd-terminal-dot jd-terminal-dot--red"></span>
                            <span class="jd-terminal-dot jd-terminal-dot--yellow"></span>
                            <span class="jd-terminal-dot jd-terminal-dot--green"></span>
                            <span class="jd-terminal__title">rene@je-developpe — zsh</span>
                        </div>
                        <div class="jd-terminal__body" id="jd-live-terminal"
                             data-whoami="{{ h1 }}"
                             data-home-route="{{ path('site_home') }}"
                             data-knowledges-route="{{ path('site_my_knowledges') }}"
                             data-projects-route="{{ path('site_my_projects') }}"
                             data-trainings-route="{{ path('site_my_trainings') }}"
                             data-blog-route="{{ path('site_my_categories') }}"
                             data-contact-route="{{ path('site_contact') }}"
                             data-linkedin-url="http://www.linkedin.com/in/wetta-rene-jd"
                             data-github-url="https://github.com/JeDeveloppe">
                            <p class="jd-terminal-line"><span class="jd-terminal-prompt">$</span> whoami</p>
                            <p class="jd-terminal-line jd-terminal-line--indent">{{ h1 }}</p>
                            <p class="jd-terminal-line"><span class="jd-terminal-prompt">$</span> cat pourquoi.txt</p>
                            <p class="jd-terminal-line jd-terminal-line--center"><span class="jd-terminal-typed" {{ stimulus_controller('symfony/ux-typed', {
                                strings: ['pour m\'entrainer et m\'améliorer ', 'pour tester mes connaissances... ','pour mettre en pratique mes connaissances ', 'pour vous dire que je suis autodidacte à 100%... '],
                                smartBackspace: true,
                                loop: true,
                                cursorChar: '|'
                            }) }}></span></p>

                            <div id="jd-live-terminal__output"></div>

                            <p class="jd-terminal-line jd-live-terminal__prompt-line">
                                <span class="jd-terminal-prompt">$</span>
                                <input type="text" id="jd-live-terminal__input" class="jd-live-terminal__input" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Terminal interactif : tapez 'help' pour la liste des commandes">
                            </p>
                        </div>
                    </div>
                    <p class="jd-live-terminal__hint text-white-50 small mt-2 mb-0">
                        <i class="fa-solid fa-keyboard me-1"></i>Ce terminal est utilisable : tapez <code>help</code> pour voir les commandes.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <div class="container py-5">
        {# Call to action discret #}
        <div class="row justify-content-center mb-5">
            <div class="col-12 col-md-auto">
                <div class="alert alert-primary border-0 shadow-sm px-4 rounded-pill">
                    <i class="fa-solid fa-envelope-open-text me-2"></i>
                    <a href="{{ path('site_contact') }}" class="text-decoration-none">
                        <span class="fw-bold">Un projet ?</span> N'hésitez pas à me contacter !
                    </a>
                </div>
            </div>
        </div>

        {# Section Météo #}
        <div class="row g-4 justify-content-center">
            <div class="col-12 text-center mb-2">
                <h2 class="h3 fw-light text-secondary">
                    <i class="fa-solid fa-cloud-sun-rain me-2 text-primary"></i>
                    Données OpenWeather
                </h2>
            </div>

            {% if citiesDatas is not empty %}
                <div class="col-12">
                    <div class="jd-weather-scroll">
                        {% for city in citiesDatas %}
                            <div class="jd-weather-scroll__item">
                                <div class="card jd-card h-100 border-0 rounded-4 overflow-hidden">
                                    {# Header de carte avec un petit badge pour le pays ou le statut #}
                                    <div class="card-header bg-white border-0 pt-4 pb-0 text-center">
                                        <h3 class="h4 fw-bold text-uppercase tracking-wider mb-0">{{ city.name }}</h3>
                                        <hr class="mx-auto w-25 border-primary border-2 opacity-100">
                                    </div>

                                    <div class="card-body px-4 pb-4">
                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0 py-3">
                                                <span><i class="fa-solid fa-temperature-three-quarters text-danger me-2"></i> Températures</span>
                                                <div class="fw-bold">
                                                    <span class="text-info">{{ city.temp_min }}°</span> /
                                                    <span class="text-danger">{{ city.temp_max }}°</span>
                                                </div>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0 py-3">
                                                <span><i class="fa-solid fa-droplet text-info me-2"></i> Humidité</span>
                                                <span class="fw-bold">{{ city.humidity }} %</span>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0 py-3">
                                                <span><i class="fa-solid fa-wind text-secondary me-2"></i> Vent</span>
                                                <span class="fw-bold">{{ city.wind }} <small class="text-muted">m/s</small></span>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0 py-3">
                                                <span><i class="fa-solid fa-gauge text-warning me-2"></i> Pression</span>
                                                <span class="fw-bold small">{{ city.pressure }} hPa</span>
                                            </li>
                                        </ul>

                                        <div class="row g-0 mt-3 pt-3 border-top text-center text-muted small">
                                            <div class="col-6 border-end">
                                                <i class="fa-solid fa-sun d-block mb-1 fs-5 text-warning"></i>
                                                {{ city.sunrise }}
                                            </div>
                                            <div class="col-6">
                                                <i class="fa-solid fa-moon d-block mb-1 fs-5 text-secondary"></i>
                                                {{ city.sunset }}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="jd-weather-scroll__hint d-md-none">
                        <i class="fa-solid fa-arrows-left-right me-1"></i>Faites glisser pour voir les autres villes
                    </div>
                </div>
            {% else %}
                <div class="col-md-6">
                    <div class="card border-danger bg-light text-center p-5">
                        <i class="fa-solid fa-circle-exclamation text-danger fa-3x mb-3"></i>
                        <p class="mb-0 text-danger fw-bold">Le flux météo est actuellement interrompu.</p>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    <style>
        .jd-terminal-line--center {
            text-align: center;
            margin-top: 0.75rem;
        }
        .jd-terminal-typed {
            color: var(--jd-teal);
            font-weight: 600;
        }

        .jd-weather-scroll {
            display: flex;
            gap: 1.25rem;
            overflow-x: auto;
            scroll-snap-type: x proximity;
            padding: 0.25rem 0.25rem 1rem;
            scrollbar-width: thin;
            scrollbar-color: var(--jd-teal, #18bc9c) transparent;
        }
        .jd-weather-scroll::-webkit-scrollbar {
            height: 6px;
        }
        .jd-weather-scroll::-webkit-scrollbar-thumb {
            background-color: var(--jd-teal, #18bc9c);
            border-radius: 999px;
        }
        .jd-weather-scroll::-webkit-scrollbar-track {
            background: transparent;
        }
        .jd-weather-scroll__item {
            flex: 0 0 auto;
            scroll-snap-align: start;
            width: 260px;
        }
        @media (min-width: 768px) {
            .jd-weather-scroll__item {
                width: 300px;
            }
        }
        .jd-weather-scroll__hint {
            text-align: center;
            font-size: 0.8rem;
            color: var(--bs-secondary-color, #6c757d);
            margin-top: -0.5rem;
        }

        .jd-live-terminal__prompt-line {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .jd-live-terminal__input {
            flex: 1 1 auto;
            background: transparent;
            border: none;
            outline: none;
            color: inherit;
            font: inherit;
            padding: 0;
            min-width: 0;
        }
        .jd-live-terminal__input::placeholder {
            color: rgba(255, 255, 255, 0.35);
        }
        #jd-live-terminal__output .jd-terminal-line {
            word-break: break-word;
        }
        .jd-live-terminal__hint code {
            background: rgba(255, 255, 255, 0.12);
            color: var(--jd-teal);
            padding: 0.1rem 0.4rem;
            border-radius: 0.3rem;
        }
    </style>

    <script>
        document.addEventListener('turbo:load', function () {
            var root = document.getElementById('jd-live-terminal');
            if (!root || root.dataset.jdBound === '1') {
                return;
            }
            root.dataset.jdBound = '1';

            var output = document.getElementById('jd-live-terminal__output');
            var input = document.getElementById('jd-live-terminal__input');
            var history = [];
            var historyIndex = -1;

            var routes = {
                accueil: root.dataset.homeRoute,
                home: root.dataset.homeRoute,
                connaissances: root.dataset.knowledgesRoute,
                'mes-connaissances': root.dataset.knowledgesRoute,
                realisations: root.dataset.projectsRoute,
                'mes-realisations': root.dataset.projectsRoute,
                projets: root.dataset.projectsRoute,
                formations: root.dataset.trainingsRoute,
                'mes-formations': root.dataset.trainingsRoute,
                blog: root.dataset.blogRoute,
                contact: root.dataset.contactRoute
            };

            function printLine(text, variant) {
                var p = document.createElement('p');
                p.className = 'jd-terminal-line' + (variant ? ' ' + variant : '');
                p.textContent = text;
                output.appendChild(p);
            }

            function printCommandEcho(cmd) {
                var p = document.createElement('p');
                p.className = 'jd-terminal-line';
                var prompt = document.createElement('span');
                prompt.className = 'jd-terminal-prompt';
                prompt.textContent = '$';
                p.appendChild(prompt);
                p.appendChild(document.createTextNode(' ' + cmd));
                output.appendChild(p);
            }

            function navigate(url) {
                if (!url) {
                    return;
                }
                if (window.Turbo) {
                    window.Turbo.visit(url);
                } else {
                    window.location.href = url;
                }
            }

            function runCommand(raw) {
                var trimmed = raw.trim();
                if (trimmed === '') {
                    return;
                }

                printCommandEcho(trimmed);
                history.push(trimmed);
                historyIndex = history.length;

                var parts = trimmed.split(/\s+/);
                var cmd = parts[0].toLowerCase();
                var arg = (parts[1] || '').toLowerCase();

                switch (cmd) {
                    case 'help':
                        printLine('Commandes disponibles :', 'jd-terminal-line--indent');
                        printLine('help                 affiche cette aide', 'jd-terminal-line--indent');
                        printLine('whoami               qui suis-je', 'jd-terminal-line--indent');
                        printLine('ls                   liste les pages du site', 'jd-terminal-line--indent');
                        printLine('cd <page>            navigue vers une page (ex: cd projets)', 'jd-terminal-line--indent');
                        printLine('cat pourquoi.txt     pourquoi ce site existe', 'jd-terminal-line--indent');
                        printLine('open linkedin|github ouvre mon profil', 'jd-terminal-line--indent');
                        printLine('contact              raccourci vers la page contact', 'jd-terminal-line--indent');
                        printLine('clear                efface ce terminal', 'jd-terminal-line--indent');
                        break;

                    case 'whoami':
                        printLine(root.dataset.whoami, 'jd-terminal-line--indent');
                        break;

                    case 'ls':
                        printLine('connaissances/  realisations/  formations/  blog/  contact/', 'jd-terminal-line--indent');
                        break;

                    case 'cd':
                        var target = arg.replace(/^\/+|\/+$/g, '');
                        if (target === '' || target === '..') {
                            navigate(root.dataset.homeRoute);
                        } else if (routes[target]) {
                            navigate(routes[target]);
                        } else {
                            printLine('zsh: no such page: ' + arg, 'jd-terminal-line--indent');
                        }
                        break;

                    case 'contact':
                        navigate(root.dataset.contactRoute);
                        break;

                    case 'cat':
                        if (arg === 'pourquoi.txt' || arg === 'about.txt') {
                            printLine("pour m'entrainer, tester et mettre en pratique mes connaissances — je suis autodidacte à 100%.", 'jd-terminal-line--indent');
                        } else {
                            printLine('cat: ' + (arg || 'fichier') + ': fichier introuvable', 'jd-terminal-line--indent');
                        }
                        break;

                    case 'open':
                        if (arg === 'linkedin') {
                            window.open(root.dataset.linkedinUrl, '_blank', 'noopener');
                        } else if (arg === 'github') {
                            window.open(root.dataset.githubUrl, '_blank', 'noopener');
                        } else {
                            printLine('usage: open linkedin|github', 'jd-terminal-line--indent');
                        }
                        break;

                    case 'sudo':
                        printLine("Permission refusée : vous n'êtes pas root ici 😄", 'jd-terminal-line--indent');
                        break;

                    case 'clear':
                        output.innerHTML = '';
                        break;

                    default:
                        printLine('zsh: commande introuvable : ' + cmd + ' (tapez "help")', 'jd-terminal-line--indent');
                }
            }

            input.addEventListener('keydown', function (event) {
                if (event.key === 'Enter') {
                    runCommand(input.value);
                    input.value = '';
                } else if (event.key === 'ArrowUp') {
                    if (history.length > 0 && historyIndex > 0) {
                        historyIndex--;
                        input.value = history[historyIndex];
                    }
                    event.preventDefault();
                } else if (event.key === 'ArrowDown') {
                    if (historyIndex < history.length - 1) {
                        historyIndex++;
                        input.value = history[historyIndex];
                    } else {
                        historyIndex = history.length;
                        input.value = '';
                    }
                    event.preventDefault();
                }
            });

            root.addEventListener('click', function () {
                input.focus();
            });
        });
    </script>
{% endblock %}
