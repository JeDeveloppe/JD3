{% extends 'site/components/_base.html.twig' %}

{% block title %}Mentions légales{% endblock %}

{% block body %}

    <section class="jd-hero">
        <div class="jd-hero__glow jd-hero__glow--teal"></div>
        <div class="jd-hero__clip">
            <div class="jd-hero__glow jd-hero__glow--navy"></div>
        </div>

        <div class="container position-relative jd-hero__inner">
            <div class="row align-items-center g-5">
                <div class="col-12 col-lg-6 text-center text-lg-start">
                    <span class="jd-hero__eyebrow">
                        <i class="fa-solid fa-scale-balanced me-2"></i>Informations légales
                    </span>
                    <h1 class="jd-hero__title">Mentions légales</h1>
                    <p class="jd-hero__lead mx-auto mx-lg-0">
                        Dernière mise à jour le {{ legales.updatedAt | date('d/m/Y') }}.
                    </p>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="jd-terminal" role="button" tabindex="0" data-bs-toggle="modal" data-bs-target="#jdTerminalModal" aria-label="Ouvrir le terminal interactif">
                        <div class="jd-terminal__bar">
                            <span class="jd-terminal-dot jd-terminal-dot--red"></span>
                            <span class="jd-terminal-dot jd-terminal-dot--yellow"></span>
                            <span class="jd-terminal-dot jd-terminal-dot--green"></span>
                            <span class="jd-terminal__title">rene@je-developpe — legal</span>
                        </div>
                        <div class="jd-terminal__body">
                            <p class="jd-terminal-line"><span class="jd-terminal-prompt">$</span> cat mentions-legales.txt</p>
                            <p class="jd-terminal-line jd-terminal-line--indent">Propriétaire : {{ legales.companyName }}</p>
                            <p class="jd-terminal-line jd-terminal-line--indent">Contact : {{ legales.emailCompany }}</p>
                            <p class="jd-terminal-line jd-terminal-line--indent">Hébergeur : {{ legales.hostName }}</p>
                            <p class="jd-terminal-line jd-terminal-line--indent">Webmaster : {{ legales.webmasterCompanyName }}</p>
                            <p class="jd-terminal-line"><span class="jd-terminal-prompt">$</span> <span class="jd-terminal-cursor"></span></p>
                        </div>
                        <div class="jd-terminal__open-hint">
                            <i class="fa-solid fa-keyboard me-1"></i>Cliquez pour ouvrir le terminal interactif
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {% include 'site/components/_terminal_modal.html.twig' %}

    <div class="container my-5 py-3">
        <div class="row g-0 justify-content-center">
            <div class="col-12 col-lg-10 col-xl-8 mb-4">
                <div class="card jd-card border-0 rounded-4 p-4">
                    <h3 class="h5 fw-bold mb-3" style="color: var(--jd-navy);">Informations légales</h3>
                    <p class="mb-0">
                        <span class="fw-bolder">Propriétaire du site :</span> {{ legales.companyName }}<br />
                        <span class="fw-bolder">Contact :</span> <a href="mailto:{{ legales.emailCompany }}" class="text-decoration-none">{{ legales.emailCompany }}</a><br />
                        <span class="fw-bolder">Adresse :</span> {{ legales.streetCompany }} {{ legales.postalCodeCompany }} {{ legales.cityCompany }}<br />
                        <span class="fw-bolder">Hébergeur du site :</span> {{ legales.hostName }} {{ legales.hostStreet }} {{ legales.hostPostalCode }} {{ legales.hostCity }}<br/>
                        <span class="fw-bolder">Développement & webmaster :</span> {{ legales.webmasterCompanyName }}<br />
                        <span class="fw-bolder">Webdesign :</span> {{ legales.webdesignerName }}
                    </p>
                </div>
            </div>

            {% for paragraph in paragraphs %}
                <div class="col-12 col-lg-10 col-xl-8 mb-4">
                    <div class="card jd-card border-0 rounded-4 p-4">
                        <h3 class="h5 fw-bold mb-3" style="color: var(--jd-navy);">{{ paragraph.title }}</h3>
                        <p class="mb-0">{{ paragraph.text | raw }}</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

{% endblock %}