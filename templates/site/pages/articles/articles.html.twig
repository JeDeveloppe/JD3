{% extends "site/components/_base.html.twig" %}
{% block title %}
    {{ h1 }}
{% endblock %}
{% block body %}

    <div class="container my-5">
        {% include "site/components/_breadcrumb.html.twig" with {category: category} %}

        <div class="row g-0 justify-content-center mb-2">
            <div class="col-12 col-md-10 col-lg-8 text-center">
                <div class="jd-card__icon jd-card__icon--category mx-auto mb-3">
                    <twig:ux:icon name="{{ category.renderIconStringWithoutParentheses }}" style="width:40px; height:40px;"/>
                </div>
                <h1 class="visually-hidden">{{ category.name }}</h1>
            </div>
        </div>

        {% include "site/forms/_search_article.html.twig" %}

        <div class="row g-3 justify-content-center">
            <div class="col-12 col-md-10 col-lg-8">
                {% if articles is not empty %}
                    {% for article in articles %}
                        <div class="card jd-card mb-3 border-0 rounded-4">
                            <div class="card-body p-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                <h2 class="h5 fw-bold text-dark mb-0">{{ article.name }}</h2>
                                <div class="d-flex align-items-center flex-shrink-0">
                                    {% if is_granted('ROLE_SUPER_ADMIN') %}
                                        <a class="btn btn-outline-secondary btn-sm me-2" target="_blank" href="{{ ea_url().setController('App\\Controller\\Admin\\ArticleCrudController').setAction('edit')}}">
                                            <span class="fa fa-edit"></span>
                                        </a>
                                    {% endif %}
                                    <a class="btn btn-primary btn-sm rounded-pill px-3" href="{{ path('mapped_article_details', {categorySlug: category.slug, articleSlug: article.slug }) }}">
                                        Voir l'article
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="alert alert-light border text-center mt-4" role="alert">
                        <i class="fa-solid fa-circle-info me-2 text-muted"></i>
                        Aucune astuce pour le moment...! (J'y travaille)
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
