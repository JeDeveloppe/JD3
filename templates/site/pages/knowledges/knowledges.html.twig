{% extends "site/components/_base.html.twig" %}

{% block title %}{{ h1 }}{% endblock %}

{% block body %}

    {# --- Aplatit toutes les technologies pour les stats et le terminal --- #}
    {% set allTechs = [] %}
    {% for family in technologiesFamilies %}
        {% for tech in family.technologies %}
            {% if tech.isUsed %}
                {% set allTechs = allTechs|merge([tech]) %}
            {% endif %}
        {% endfor %}
    {% endfor %}
    {% set topTechs = allTechs|sort((a, b) => b.knowledgeRate <=> a.knowledgeRate)|slice(0, 5) %}
    {% set totalRate = 0 %}
    {% for t in allTechs %}
        {% set totalRate = totalRate + t.knowledgeRate %}
    {% endfor %}
    {% set avgRate = allTechs|length > 0 ? (totalRate / allTechs|length)|round : 0 %}

    {# --- Technos non pratiquées : simple mention, aucun score/calcul --- #}
    {% set alsoSeenTechs = [] %}
    {% for family in technologiesFamilies %}
        {% for tech in family.technologies %}
            {% if not tech.isUsed %}
                {% set alsoSeenTechs = alsoSeenTechs|merge([tech]) %}
            {% endif %}
        {% endfor %}
    {% endfor %}

    <section class="jd-hero">
        <div class="jd-hero__glow jd-hero__glow--teal"></div>
        <div class="jd-hero__clip">
            <div class="jd-hero__glow jd-hero__glow--navy"></div>
        </div>

        <div class="container position-relative jd-hero__inner">
            <div class="row align-items-center g-5">
                <div class="col-12 col-lg-6">
                    <span class="jd-hero__eyebrow">
                        <i class="fa-solid fa-terminal me-2"></i>Stack &amp; compétences
                    </span>
                    <h1 class="jd-hero__title">{{ h1 }}</h1>
                    <p class="jd-hero__lead">
                        {{ allTechs|length }} technologies pratiquées à travers {{ technologiesFamilies|length }} familles,
                        avec une maîtrise moyenne de {{ avgRate }}%.
                    </p>

                    <div class="jd-hero__stats">
                        <div class="jd-stat">
                            <span class="jd-stat__value">{{ allTechs|length }}</span>
                            <span class="jd-stat__label">Technologies</span>
                        </div>
                        <div class="jd-stat">
                            <span class="jd-stat__value">{{ technologiesFamilies|length }}</span>
                            <span class="jd-stat__label">Familles</span>
                        </div>
                        <div class="jd-stat">
                            <span class="jd-stat__value">{{ avgRate }}<small>%</small></span>
                            <span class="jd-stat__label">Maîtrise moy.</span>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="jd-terminal" role="button" tabindex="0" data-bs-toggle="modal" data-bs-target="#jdTerminalModal" aria-label="Ouvrir le terminal interactif">
                        <div class="jd-terminal__bar">
                            <span class="jd-terminal-dot jd-terminal-dot--red"></span>
                            <span class="jd-terminal-dot jd-terminal-dot--yellow"></span>
                            <span class="jd-terminal-dot jd-terminal-dot--green"></span>
                            <span class="jd-terminal__title">user@jd — zsh</span>
                        </div>
                        <div class="jd-terminal__body">
                            <p class="jd-terminal-line"><span class="jd-terminal-prompt">$</span> top-skills --sort=knowledge --limit=5</p>
                            {% for tech in topTechs %}
                                <p class="jd-terminal-line jd-terminal-line--result">
                                    <span class="jd-terminal-result-name">{{ tech.name }}</span>
                                    <span class="jd-terminal-bar">{% for i in 1..(tech.knowledgeRate // 10) %}█{% endfor %}{% for i in 1..(10 - tech.knowledgeRate // 10) %}░{% endfor %}</span>
                                    <span class="jd-terminal-result-rate">{{ tech.knowledgeRate }}%</span>
                                </p>
                            {% endfor %}
                            <p class="jd-terminal-line"><span class="jd-terminal-prompt">$</span> <span class="jd-terminal-cursor"></span></p>
                        </div>
                        <div class="jd-terminal__open-hint">
                            <i class="fa-solid fa-keyboard me-1"></i>Cliquez pour ouvrir le terminal interactif
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {% include 'site/components/_terminal_modal.html.twig' %}

    <div class="container py-5">
        <div class="row g-4 justify-content-center align-items-start">

            {# --- COLONNE GAUCHE : TECHNOLOGIES --- #}
            <div class="col-12 col-lg-7 order-1 order-lg-0">
                {% for technologyFamily in technologiesFamilies %}
                    {% if technologyFamily.technologies|filter(t => t.isUsed)|length > 0 %}
                    <div class="card jd-card mb-4 border-0 rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <div class="jd-card__icon me-3">
                                    <i class="fa-solid fa-layer-group"></i>
                                </div>
                                <h2 class="h4 mb-0 fw-bold">{{ technologyFamily.name }}</h2>
                            </div>

                            <p class="text-muted small mb-4">{{ technologyFamily.description }}</p>

                            <div class="row g-3">
                                {% for technology in technologyFamily.technologies|filter(t => t.isUsed)|sort((b, a) => a.knowledgeRate <=> b.knowledgeRate) %}
                                    <div class="col-12">
                                        <div class="tech-row">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fw-semibold">
                                                    <twig:ux:icon name="{{ technology.renderIconStringWithoutParentheses }}" class="me-2 text-dark" style="width:20px; height:20px;"/>
                                                    {{ technology.name }}
                                                </span>
                                                <span class="badge jd-badge">{{ technology.knowledgeRate }}%</span>
                                            </div>
                                            <div class="progress knowledge-progress rounded-pill" style="height: 6px;">
                                                <div class="progress-bar knowledge-progress-bar"
                                                     role="progressbar"
                                                     style="width: {{ technology.knowledgeRate }}%"
                                                     aria-valuenow="{{ technology.knowledgeRate }}"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100">
                                                </div>
                                            </div>
                                            <p class="tech-row__cmd">
                                                <i class="fa-solid fa-chevron-right me-1"></i>{{ technology.skillCommand ?: (technology.name|lower ~ ' --version') }}
                                            </p>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                    {% endif %}
                {% endfor %}
            </div>

            {# --- COLONNE DROITE : GRAPHIQUE (STICKY) --- #}
            <div class="col-12 col-lg-5 order-0 order-lg-1 sticky-lg-top" style="top: 2rem; z-index: 10;">
                <div class="card jd-card jd-card--chart border-0 rounded-4 overflow-hidden">
                    <div class="card-header bg-transparent border-0 pt-4 pb-0 text-center">
                        <h3 class="h5 fw-bold mb-0">Niveau moyen par famille</h3>
                    </div>
                    <div class="card-body p-4">
                        <div style="min-height: 300px;" class="d-flex align-items-center">
                            {{ render_chart(chart, {'class': 'w-100 h-100'}) }}
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    {% if alsoSeenTechs|length > 0 %}
        <div class="container">
            <hr class="also-seen__hr">
            <div class="also-seen text-center pb-5">
                <p class="also-seen__label">J'ai aussi croisé, sans les pratiquer au quotidien</p>
                <div class="also-seen__tags">
                    {% for tech in alsoSeenTechs %}
                        <span class="also-seen__tag">
                            <twig:ux:icon name="{{ tech.renderIconStringWithoutParentheses }}" style="width:16px; height:16px;"/>
                            {{ tech.name }}
                        </span>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endif %}

    <style>
        /* ---------- CARD (variante graphique) ---------- */
        .jd-card--chart {
            background: linear-gradient(180deg, #fff 0%, #f7fbfa 100%);
        }

        /* ---------- PROGRESS ---------- */
        .knowledge-progress {
            background-color: #eef1f2;
            overflow: visible;
        }
        .knowledge-progress-bar {
            background: linear-gradient(90deg, var(--jd-teal), var(--jd-cyan));
            transition: width 1.2s cubic-bezier(0.16, 1, 0.3, 1);
            border-radius: 50px;
            box-shadow: 0 0 10px rgba(24, 188, 156, 0.35);
        }

        /* ---------- TERMINAL COMMAND CAPTION ---------- */
        .tech-row__cmd {
            font-family: 'SFMono-Regular', Consolas, Menlo, monospace;
            font-size: 0.72rem;
            color: #8b98a3;
            background: #f3f6f6;
            border-radius: 0.4rem;
            padding: 0.3rem 0.55rem;
            margin: 0.5rem 0 0;
            max-width: 100%;
            overflow-x: auto;
            white-space: nowrap;
            opacity: 0;
            max-height: 0;
            transform: translateY(-4px);
            transition: opacity 0.2s ease, transform 0.2s ease, margin 0.2s ease, max-height 0.2s ease;
        }
        .tech-row:hover .tech-row__cmd {
            opacity: 1;
            max-height: 2.5rem;
            transform: translateY(0);
        }

        /* ---------- AUSSI CROISÉ ---------- */
        .also-seen__hr {
            max-width: 12rem;
            margin: 0 auto 2.5rem;
            border: none;
            border-top: 2px solid rgba(44, 62, 80, 0.1);
        }
        .also-seen__label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #8b98a3;
            margin-bottom: 1.25rem;
        }
        .also-seen__tags {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.6rem;
        }
        .also-seen__tag {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.4rem 0.85rem;
            border-radius: 50px;
            background: rgba(44, 62, 80, 0.05);
            color: #6c7a86;
            font-size: 0.85rem;
            font-weight: 500;
            border: 1px solid rgba(44, 62, 80, 0.08);
        }

        @media (max-width: 991.98px) {
            .tech-row__cmd {
                opacity: 1;
                max-height: 2.5rem;
                transform: none;
            }
        }
    </style>
{% endblock %}
