{% extends "site/components/_base.html.twig" %}

{% block title %}Contactez-moi !{% endblock %}

{% block body %}

    <section class="jd-hero">
        <div class="jd-hero__glow jd-hero__glow--teal"></div>
        <div class="jd-hero__clip">
            <div class="jd-hero__glow jd-hero__glow--navy"></div>
        </div>

        <div class="container position-relative jd-hero__inner text-center text-lg-start">
            <span class="jd-hero__eyebrow">
                <i class="fa-regular fa-paper-plane me-2"></i>Contact
            </span>
            <h1 class="jd-hero__title">{{ h1 }}</h1>
            <p class="jd-hero__lead mx-auto mx-lg-0">
                Un projet en tête ou juste envie de discuter code ? Envoyez-moi un message, je réponds généralement en moins de 24h.
            </p>
        </div>
    </section>

<div class="container my-5 py-md-5">
    <div class="row g-5 justify-content-center">

        {# --- COLONNE INFOS : Pour humaniser le contact --- #}
        <div class="col-12 col-lg-4">
            <div class="pe-lg-4">
                <div class="d-flex align-items-center mb-4">
                    <div class="jd-card__icon me-3">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold">Localisation</h6>
                        <span class="text-muted">Basé en France, disponible partout.</span>
                    </div>
                </div>

                <div class="d-flex align-items-center mb-4">
                    <div class="jd-card__icon me-3">
                        <i class="fa-solid fa-code"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold">Statut</h6>
                        <span class="text-muted">Ouvert aux nouvelles opportunités.</span>
                    </div>
                </div>
            </div>
        </div>

        {# --- COLONNE FORMULAIRE --- #}
        <div class="col-12 col-lg-7">
            <div class="card jd-card border-0 rounded-4 p-2 p-md-4">
                <div class="card-body">
                    {{ form_start(form, {'attr': {'class': 'row g-4', 'novalidate': 'novalidate'}}) }}
                        
                        <div class="col-md-6">
                            <div class="form-floating mb-1">
                                {{ form_widget(form.email, {'attr': {'class': 'form-control border-0 bg-light', 'placeholder': 'nom@exemple.com'}}) }}
                                {{ form_label(form.email, 'Votre email') }}
                            </div>
                            <div class="small text-danger">{{ form_errors(form.email) }}</div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating mb-1">
                                {{ form_widget(form.sujet, {'attr': {'class': 'form-control border-0 bg-light', 'placeholder': 'Sujet'}}) }}
                                {{ form_label(form.sujet, 'Sujet du message') }}
                            </div>
                            <div class="small text-danger">{{ form_errors(form.sujet) }}</div>
                        </div>

                        <div class="col-12">
                            <div class="form-floating mb-1">
                                {{ form_widget(form.message, {'attr': {
                                    'class': 'form-control border-0 bg-light', 
                                    'placeholder': 'Votre message', 
                                    'style': 'height: 180px;'
                                }}) }}
                                {{ form_label(form.message, 'Comment puis-je vous aider ?') }}
                            </div>
                            <div class="small text-danger">{{ form_errors(form.message) }}</div>
                        </div>

                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-primary w-100 py-3 fw-bold rounded-3 shadow">
                                <i class="fa-regular fa-paper-plane me-2"></i> Envoyer le message
                            </button>
                        </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    /* Focus effect plus propre */
    .form-control:focus {
        background-color: #fff !important;
        box-shadow: 0 0 0 0.25rem rgba(24, 188, 156, 0.15);
        border: 1px solid var(--jd-teal) !important;
    }
    /* Style pour les labels du form-floating */
    .form-floating > label {
        color: #6c757d;
        padding-left: 1.2rem;
    }
    /* Transition sur le bouton */
    .btn-primary {
        transition: all 0.3s ease;
    }
    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 15px rgba(44, 62, 80, 0.25) !important;
    }
</style>
{% endblock %}