{% extends "site/components/_base.html.twig" %}
{% block title %}Mes articles pour ne plus chercher sur Google !{% endblock %}
{% block body %}

    {% set totalArticles = 0 %}
    {% for category in categories %}
        {% set totalArticles = totalArticles + category.articles|length %}
    {% endfor %}

    <section class="jd-hero">
        <div class="jd-hero__glow jd-hero__glow--teal"></div>
        <div class="jd-hero__clip">
            <div class="jd-hero__glow jd-hero__glow--navy"></div>
        </div>

        <div class="container position-relative jd-hero__inner text-center text-lg-start">
            <span class="jd-hero__eyebrow">
                <i class="fa-solid fa-book me-2"></i>Blog
            </span>
            <h1 class="jd-hero__title">{{ h1 }}</h1>
            <p class="jd-hero__lead mx-auto mx-lg-0">{{ lead | raw }}</p>

            <div class="jd-hero__stats justify-content-center justify-content-lg-start">
                <div class="jd-stat">
                    <span class="jd-stat__value">{{ totalArticles }}</span>
                    <span class="jd-stat__label">Astuces</span>
                </div>
                <div class="jd-stat">
                    <span class="jd-stat__value">{{ categories|length }}</span>
                    <span class="jd-stat__label">Catégories</span>
                </div>
            </div>
        </div>
    </section>

    <div class="container py-5">
        <div class="row g-4 justify-content-center">
            {% for key, category in categories %}
                <div class="col-6 col-sm-6 col-md-4 col-lg-3 col-xl-2 d-flex">
                    <article class="card jd-card h-100 w-100 border-0 rounded-4">
                        <a href="{{ path('mapped_my_articles_from_category', {categorySlug: category.slug }) }}" class="stretched-link"></a>

                        <div class="card-body p-4 text-center">
                            <div class="jd-card__icon jd-card__icon--center mx-auto mb-3">
                                <twig:ux:icon name="{{ category.renderIconStringWithoutParentheses }}" style="width:24px; height:24px;"/>
                            </div>

                            <h2 class="h5 fw-bold text-dark mb-2">{{ category.name }}</h2>

                            {% set articlesLabel = (category.articles | length) > 1 ? 'articles' : 'article' %}
                            <p class="text-muted small mb-0">{{ category.articles | length }} {{ articlesLabel }}</p>
                        </div>

                        <div class="card-footer bg-transparent border-0 pb-3 text-center">
                            <small class="text-muted fst-italic">
                                {% if lastArticles[category.name] is defined and lastArticles[category.name] is not null %}
                                    Mis à jour le <span class="fw-bold">{{ lastArticles[category.name].updatedAt | date("d/m/Y") }}</span>
                                {% else %}
                                    Bientôt...
                                {% endif %}
                            </small>
                        </div>
                    </article>
                </div>
            {% endfor %}
        </div>
    </div>

    {{ knp_pagination_render(categories, 'site/components/_pagination.html.twig') }}
{% endblock %}
