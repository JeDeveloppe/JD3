<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>CV - RENÉ WETTA (Ciblé Manager)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --cv-navy: #2c3e50;
            --cv-accent: #18bc9c;
        }

        body { background-color: #eef1f2; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; }
        .cv-container { box-shadow: 0 15px 45px rgba(44, 62, 80, 0.12); }
        .sidebar { background-color: var(--cv-navy); color: white; padding: 2.25rem 2rem; }
        .main-content { padding: 2.5rem; background-color: white; }
        .section-title {
            color: var(--cv-navy);
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            font-size: 0.95rem;
            border-bottom: 3px solid var(--cv-accent);
            display: inline-block;
            padding-bottom: 0.4rem;
            margin-bottom: 1.25rem;
        }
        .experience-header { margin-top: 1.5rem; }
        .skill-badge { margin: 0.2rem; font-weight: 500; }

        /* ---------- Stats clés (extraits du profil) ---------- */
        .cv-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0.75rem;
            margin: 1.5rem 0 2rem;
        }
        .cv-stat {
            background: #f5f8f8;
            border-left: 3px solid var(--cv-accent);
            border-radius: 0.4rem;
            padding: 0.75rem 0.9rem;
        }
        .cv-stat__value { display: block; font-size: 1.4rem; font-weight: 800; color: var(--cv-navy); line-height: 1.1; }
        .cv-stat__label { font-size: 0.72rem; color: #6c7a86; text-transform: uppercase; letter-spacing: 0.03em; }

        /* ---------- Timeline experiences ---------- */
        .cv-timeline { position: relative; padding-left: 1.75rem; }
        .cv-timeline::before {
            content: '';
            position: absolute;
            left: 0.28rem;
            top: 0.4rem;
            bottom: 0.4rem;
            width: 2px;
            background: linear-gradient(180deg, var(--cv-accent), #dfe6e6);
        }
        .cv-timeline__marker {
            position: absolute;
            left: -1.75rem;
            top: 0.3rem;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--cv-navy);
            border: 2px solid #fff;
            box-shadow: 0 0 0 2px #dfe6e6;
        }
        .cv-timeline__item:first-child .cv-timeline__marker {
            background: var(--cv-accent);
            box-shadow: 0 0 0 2px rgba(24, 188, 156, 0.25);
        }

        /* ---------- Sidebar : atout digital ---------- */
        .cv-digital-note {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(24, 188, 156, 0.35);
            border-radius: 0.5rem;
            padding: 0.75rem 0.9rem;
            font-size: 0.78rem;
            line-height: 1.4;
            color: rgba(255, 255, 255, 0.85);
        }
        .cv-digital-note strong { color: var(--cv-accent); }

        .skill-category-title {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            font-weight: 700;
            margin-bottom: 0.4rem;
        }
        .skill-category--highlight {
            border: 1px dashed rgba(24, 188, 156, 0.5);
            border-radius: 0.6rem;
            padding: 0.75rem;
            margin-bottom: 0.75rem;
        }

        /* Styles pour le compteur de vues (écran) */
        .footer-message {
            margin-top: 3rem;
            padding: 1.5rem;
            background-color: #f0f8ff;
            border-radius: 8px;
            text-align: center;
            border: 1px solid var(--cv-accent);
            opacity: 0;
            transition: opacity 0.8s ease-in-out;
        }
        .footer-message.visible { opacity: 1; }
        .download-button-area {
            text-align: right;
            margin-top: 1.5rem;
            margin-bottom: 1rem;
        }

        /* ================================================= */
        /* === RÈGLES CRITIQUES POUR L'IMPRESSION (ULTRA-COMPRESSION & ESPACE AÉRÉ) === */
        /* ================================================= */
        @media print {

            /* RESET GLOBAL et COMPRESSION TYPOGRAPHIQUE MAXIMALE */
            body, html {
                font-size: 9pt !important;
                line-height: 1.0 !important;
                margin: 0 !important;
                padding: 0 !important;
            }

            /* Retirer toutes les marges et paddings par défaut */
            .cv-container, .row, ul, li, p, h1, h2, h3, h4, h5 {
                margin: 0 !important;
                padding: 0 !important;
            }

            /* Le conteneur doit masquer l'excédent de padding du hack */
            .cv-container {
                overflow: hidden !important;
                box-shadow: none !important;
                border-radius: 0 !important;
            }

            /* Ajustement spécifiques des listes */
            ul {
                margin-top: 0.1rem !important;
                /* AUGMENTATION : Plus d'espace après les listes */
                margin-bottom: 0.3rem !important;
                padding-left: 0.8rem !important;
            }
            li {
                margin-bottom: 0 !important;
            }

            /* --- FIX 1/3 - 2/3 (FLOAT) --- */
            .row {
                /* Gère le flottant */
                overflow: hidden !important;
                width: 100% !important;
                height: auto !important;
            }

            /* SIDEBAR : COLONNE 1/3 */
            .sidebar {
                float: left !important;
                width: 33.333333% !important;

                /* HACK FIXANT LE DÉBORDEMENT DE COULEUR */
                padding-bottom: 9999px !important;
                margin-bottom: -9999px !important;

                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
                background-color: #2c3e50 !important;
                color: white !important;
                padding-top: 0.5rem !important;
                padding-left: 0.5rem !important;
                padding-right: 0.5rem !important;
                border-radius: 0 !important;
            }

            /* MAIN CONTENT : COLONNE 2/3 */
            .main-content {
                float: right !important;
                width: 66.666667% !important;
                padding: 0.5rem !important;
            }

            /* --- RÈGLES D'ESPACEMENT AÉRÉ --- */
            /* AUGMENTATION : Plus d'espace après les titres de section principaux */
            .section-title { margin-bottom: 0.5rem !important; padding-bottom: 0.1rem !important; }

            /* AUGMENTATION : Plus d'espace avant un nouveau bloc d'expérience */
            .experience-header { margin-top: 0.5rem !important; margin-bottom: 0.1rem !important; }

            /* AUGMENTATION : Plus d'espace entre les grandes expériences professionnelles (classe .mb-4) */
            .mb-4, .my-3, .mb-3 { margin-bottom: 0.4rem !important; }

            /* AUGMENTATION : Plus d'espace après les petits blocs (date, compétences) */
            .mb-1, .mt-2 { margin-top: 0.2rem !important; margin-bottom: 0.2rem !important; }

            /* Les badges restent très compacts */
            .skill-badge { padding: 0.1rem 0.3rem !important; margin: 0.05rem !important; font-size: 8pt !important; }

            /* La timeline (bordure + marqueurs) ne sert a rien en impression compacte */
            .cv-timeline { padding-left: 0 !important; }
            .cv-timeline::before, .cv-timeline__marker { display: none !important; }
            .cv-stats { display: block !important; }
            .cv-stat { display: inline-block !important; border: none !important; padding: 0 0.5rem 0 0 !important; }
            .cv-digital-note { border: none !important; padding: 0 !important; }

            /* Masquer les éléments interactifs */
            .footer-message, .download-button-area, script, .btn, button {
                display: none !important;
            }

            /* Éviter les coupures disgracieuses dans le contenu */
            .mb-4, .experience-header {
                page-break-inside: avoid !important;
                page-break-after: avoid !important;
            }
        }
    </style>
</head>
<body>

